# Devcontainer /dev/null mounts.
#
# These names exist in this workspace as character devices (major/minor 1,3),
# not regular files. `git status` reports them as untracked; staging one either
# errors or commits something meaningless. They are ignored here so that
# `git status --porcelain` is trustworthy. See CLAUDE.md "Staging discipline".
.bash_profile
.bashrc
.gitconfig
.gitmodules
.idea
# Anchored to the two paths the devcontainer actually mounts /dev/null over.
# Deliberately NOT the bare name: `souroldgeezer-fivee-sim/.mcp.json` is a real,
# tracked, shipped file — the plugin's MCP manifest — and an unanchored pattern
# matches it and every future plugin's too. Ignoring a tracked file changes
# nothing today, which is exactly what makes it a trap for the restructure that
# re-adds one.
/.mcp.json
/souroldgeezer-fivee-sim/engine/.mcp.json
.profile
.ripgreprc
.vscode
.zprofile
.zshrc

# Claude Code per-project state. In this workspace every entry under .claude/
# is also a /dev/null mount, so nothing here is storable or meaningful.
.claude/

# Codex per-project hooks are workstation-local.
/.codex/hooks.json

# Git worktrees used for implementation branches.
.worktrees/

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Tool caches
.cache/

# 5E simulation runtime state (maps, replays, editor metadata, and logs)
.fivee-sim/
