# Devcontainer /dev/null mounts.
#
# These names exist in this workspace as character devices (major/minor 1,3),
# not regular files. `git status` reports them as untracked; staging one either
# errors or commits something meaningless. They are ignored here so that
# `git status --porcelain` is trustworthy. See CLAUDE.md "Staging discipline".
.bash_profile
.bashrc
.gitconfig
.gitmodules
.idea
# The bare name, and it is now the right pattern. This block used to anchor
# each path individually and said so at length, because
# `souroldgeezer-fivee-sim/.mcp.json` was a real tracked file — the plugin's MCP
# manifest — that an unanchored pattern would have swallowed.
#
# Dropping MCP deleted that file, and no `.mcp.json` is tracked anywhere now.
# The devcontainer promptly revealed a /dev/null mount at that path too, which
# the real file had been masking, and the anchored list had no entry for it.
# Enumerating mount points loses that race every time; the bare name does not.
# Restore the anchors if a tracked `.mcp.json` is ever re-added.
.mcp.json
.profile
.ripgreprc
.vscode
.zprofile
.zshrc

# Claude Code per-project state. In this workspace every entry under .claude/
# is also a /dev/null mount, so nothing here is storable or meaningful.
.claude/

# Codex per-project hooks are workstation-local.
/.codex/hooks.json

# Git worktrees used for implementation branches.
.worktrees/

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Tool caches
.cache/

# 5E simulation runtime state (maps, replays, editor metadata, and logs)
.fivee-sim/
