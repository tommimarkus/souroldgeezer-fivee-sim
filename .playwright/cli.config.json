{
  "browser": {
    "browserName": "firefox",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "firefoxUserPrefs": {
        "security.sandbox.content.level": 0,
        "security.sandbox.gmp.level": 0,
        "security.sandbox.gpu.level": 0,
        "security.sandbox.rdd.level": 0,
        "security.sandbox.socket.process.level": 0
      }
    }
  },
  "outputDir": ".cache/playwright/output",
  "outputMode": "stdout"
}
